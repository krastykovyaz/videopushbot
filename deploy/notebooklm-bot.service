[Unit]
Description=NotebookLM-clone Telegram bot (PDF -> video -> YouTube/VK)
After=network-online.target
Wants=network-online.target
# Without this, systemd's default Restart=on-failure loop is effectively
# unbounded — a bad deploy (e.g. a missing import) can restart thousands of
# times unnoticed instead of stopping and surfacing the failure. After 5
# restarts in 10 minutes, systemd stops trying; `systemctl status` then
# shows "Failed" instead of quietly cycling forever.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
# EDIT these three paths/user for your server:
User=YOUR_LINUX_USER
WorkingDirectory=/path/to/video_posting
ExecStart=/path/to/video_posting/venv/bin/python3 bot.py

Restart=on-failure
RestartSec=10

# bot.py loads its own .env via python-dotenv, so no Environment= lines needed here.

[Install]
WantedBy=multi-user.target
