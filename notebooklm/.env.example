# Telegram MTProto (получить на https://my.telegram.org)
API_ID=your_api_id
API_HASH=your_api_hash
PHONE_NUMBER=+79001234567

# Кто может слать файлы (telegram user_id через запятую, пусто = все)
ALLOWED_USERS=

# LLM (бесплатный tier)
GEMINI_API_KEY=your_gemini_key

# Язык по умолчанию (ru / en)
DEFAULT_LANG=ru

# Параллельных задач одновременно (1 = по очереди, безопаснее для RAM)
MAX_WORKERS=1

# Папка для временных файлов
WORKSPACE_DIR=./workspace
