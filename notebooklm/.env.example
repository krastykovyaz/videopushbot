# Copy to .env in the project root and fill in. Never commit the real .env.

# Telegram MTProto (https://my.telegram.org) — required
API_ID=your_api_id
API_HASH=your_api_hash
PHONE_NUMBER=+79001234567

# Who may DM the bot (telegram user_ids, comma-separated; empty = everyone)
ALLOWED_USERS=

# Gemini (script, description, topic classification)
GEMINI_API_KEY=your_gemini_key
GOOGLE_API_KEY=your_gemini_key
API_KEY=your_gemini_key
MODEL_RU=gemini-2.5-flash
MODEL_EN=gemini-2.5-flash

# Groq (fallback when every Gemini model is out of quota)
GROQ_API_KEY=your_groq_key
GROQ_MODEL=openai/gpt-oss-120b

# YouTube OAuth client secrets (paths to the downloaded JSON files)
SECRET_YOUTUBE_FILE_Ru=client_secret_youtuberu.json
SECRET_YOUTUBE_FILE_En=client_secret_desktop_app.json

# YouTube playlist IDs per category (optional)
AI_Paper_Review_Ru=
Crypto_Ideas_Ru=
GPMorgan_report_debates_Ru=
The_Economist_Ru=
The_National_Geo_talks_Ru=
Auto_Detail_Ru=
AI_Paper_Review_En=
Crypto_Ideas_En=
GPMorgan_report_debates_En=
The_Economist_En=
The_National_Geo_talks_En=

# VK video upload
VK_ACCESS_TOKEN=your_vk_token

# Gemini dialogue TTS (free tier: ~100 requests/day per model, ~10/min).
# Languages that use it; the rest (and any chunk it can't do) use Edge TTS.
GEMINI_TTS_LANGS=ru
# GEMINI_TTS_MODELS=gemini-3.8-flash-tts,gemini-3.1-flash-tts-preview,gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE_HOST1=Charon
# GEMINI_TTS_VOICE_HOST2=Kore

# Optional voice overrides (Edge TTS voice names)
# EDGE_VOICE_HOST1_RU=ru-RU-DmitryNeural
# EDGE_FALLBACK_HOST1_RU=en-US-BrianMultilingualNeural

DEFAULT_LANG=ru
MAX_WORKERS=1
WORKSPACE_DIR=./workspace

# Disk housekeeping (cleanup.py)
RETENTION_DAYS=7
DEFERRED_RETENTION_DAYS=21
MAX_LOG_MB=20
